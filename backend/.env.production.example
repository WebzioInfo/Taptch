# ==============================================================================
# TAPTCH BACKEND PRODUCTION ENVIRONMENT CONFIGURATION (.env.production)
# ==============================================================================
# Host Server / VPS / Coolify / Dokploy Configuration for api.taptch.com
# ==============================================================================

# Core Runtime Environment
NODE_ENV=production
PORT=4000
API_PREFIX=api

# Canonical Production Service URLs
BACKEND_URL=https://api.taptch.com
FRONTEND_URL=https://taptch.com

# Multi-Domain CORS Configuration (All Approved Production Web & App Origins)
ALLOWED_ORIGINS=https://www.taptch.com,https://taptch.com,https://taptch.webziotech.in,https://shop.taptch.com,https://app.taptch.com

# Cross-Domain Cookie & Session Security Settings
# In production across multiple subdomains & domains, SameSite=none + Secure=true is required
COOKIE_SAME_SITE=none
COOKIE_SECURE=true
# Optional: Set COOKIE_DOMAIN=.taptch.com to share session cookies across all *.taptch.com subdomains.
# Leave empty if you want cookies isolated to api.taptch.com with bearer token fallback for third-party domains.
COOKIE_DOMAIN=

# PostgreSQL Database (Supabase Production Managed Pooler & Direct Connection)
DATABASE_URL=postgresql://postgres:TaptchTAPH12@db.nvrcgauxafpxsaufjtha.supabase.co:5432/postgres?sslmode=require
DATABASE_URL_DIRECT=postgresql://postgres:TaptchTAPH12@db.nvrcgauxafpxsaufjtha.supabase.co:5432/postgres?sslmode=require

# Redis & Memory Cache Layer
REDIS_URL=redis://localhost:6379
USE_IN_MEMORY_REDIS=true

# Authentication (Better Auth & Session Entropy)
BETTER_AUTH_SECRET=taptch-super-secret-better-auth-key-production-entropy-64chars
BETTER_AUTH_URL=https://api.taptch.com

# Super Admin & High-Security API Tokens
ADMIN_API_KEY=taptch_admin_secret_key_prod_2026
VISITOR_SALT_SECRET=taptch-visitor-salt-production-entropy-rotating-salt-2026

# Google OAuth Single Sign-On (GIS & Web Flow)
# Authorized JavaScript Origins in Google Cloud Console:
#   https://taptch.com, https://www.taptch.com, https://app.taptch.com, https://shop.taptch.com, https://taptch.webziotech.in, https://api.taptch.com
# Authorized Redirect URIs in Google Cloud Console:
#   https://api.taptch.com/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://api.taptch.com/api/auth/oauth/google/callback

# Transactional Email Service (SMTP)
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@taptch.com
SMTP_PASS=password
EMAIL_FROM=noreply@taptch.com
EMAIL_FROM_NAME="Taptch"
