# ==============================================================================
# TAPTCH — Environment Configuration Template (.env.example)
# Copy this file to .env.local and configure your environment secrets
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PostgreSQL Database Connections (Supabase PostgreSQL - Production & Development)
# ------------------------------------------------------------------------------
# Authoritative Supabase PostgreSQL pooled connection (Port 5432 with SSL required)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.nvrcgauxafpxsaufjtha.supabase.co:5432/postgres?sslmode=require
DATABASE_URL_DIRECT=postgresql://postgres:[YOUR-PASSWORD]@db.nvrcgauxafpxsaufjtha.supabase.co:5432/postgres?sslmode=require

# Note: Local Docker PostgreSQL & PgBouncer have been permanently removed.
# Supabase PostgreSQL is the sole application database across development, staging, and production.
# Testing uses an isolated in-process PGlite database or Supabase test schema.

# ------------------------------------------------------------------------------
# 2. Supabase Client & SSR Keys
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://nvrcgauxafpxsaufjtha.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_bnnLxVjJ-o9guCQQeDDz2w_pwUQrk5b
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
CAMPAIGN_STORAGE_BUCKET=campaign-assets

# ------------------------------------------------------------------------------
# 3. Cloudflare Storage (Cloudflare Images & Cloudflare R2)
# ------------------------------------------------------------------------------
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_IMAGES_API_TOKEN=your_cloudflare_images_api_token_here
CLOUDFLARE_IMAGES_ACCOUNT_HASH=your_cloudflare_images_account_hash_here
CLOUDFLARE_R2_ACCESS_KEY_ID=your_r2_access_key_id_here
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here
CLOUDFLARE_R2_BUCKET_NAME=taptch-media
CLOUDFLARE_R2_ENDPOINT=https://your_cloudflare_account_id_here.r2.cloudflarestorage.com
CLOUDFLARE_R2_PUBLIC_BASE_URL=https://assets.taptch.com

# ------------------------------------------------------------------------------
# 4. Transactional Email & SMTP Configuration
# ------------------------------------------------------------------------------
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
EMAIL_FROM=noreply@taptch.com
EMAIL_FROM_NAME="TAPTCH"

# ------------------------------------------------------------------------------
# 5. Application URLs & Authentication (Better Auth)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=taptch-super-secret-better-auth-key-minimum-32-chars-long

# ------------------------------------------------------------------------------
# 6. Redis & Background Worker Queue (BullMQ)
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
USE_IN_MEMORY_REDIS=false

# ------------------------------------------------------------------------------
# 7. Security, Privacy & Admin APIs
# ------------------------------------------------------------------------------
ADMIN_API_KEY=taptch_admin_secret_key_2026
VISITOR_SALT_SECRET=taptch-visitor-salt-2026-production-entropy
OTP_PROVIDER=console

