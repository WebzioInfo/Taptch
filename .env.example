# ==============================================================================
# TAPTCH — Environment Configuration Template (.env.example)
# Copy this file to .env.local and configure your environment secrets
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PostgreSQL Database Connections (Supabase or Local)
# ------------------------------------------------------------------------------
# Direct Supabase PostgreSQL URL (Port 5432)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.nvrcgauxafpxsaufjtha.supabase.co:5432/postgres
DATABASE_URL_DIRECT=postgresql://postgres:[YOUR-PASSWORD]@db.nvrcgauxafpxsaufjtha.supabase.co:5432/postgres

# Alternatively, for local Docker Compose:
# DATABASE_URL=postgres://taptch_app:taptch_app_pass@localhost:6432/taptch_db?sslmode=disable
# DATABASE_URL_DIRECT=postgres://taptch_migrator:taptch_migrator_pass@localhost:5432/taptch_db?sslmode=disable

# ------------------------------------------------------------------------------
# 2. Supabase Client & SSR Keys
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://nvrcgauxafpxsaufjtha.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_bnnLxVjJ-o9guCQQeDDz2w_pwUQrk5b
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
CAMPAIGN_STORAGE_BUCKET=campaign-assets

# ------------------------------------------------------------------------------
# 3. Cloudinary Media Storage (Avatars, Logos & Profile Images)
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=dhydmxcq2
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=dhydmxcq2
CLOUDINARY_API_KEY=your_cloudinary_api_key_here
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here

# ------------------------------------------------------------------------------
# 4. Transactional Email & SMTP Configuration
# ------------------------------------------------------------------------------
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
EMAIL_FROM=noreply@taptch.com
EMAIL_FROM_NAME="TAPTCH"

# ------------------------------------------------------------------------------
# 5. Application URLs & Authentication (Better Auth)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=taptch-super-secret-better-auth-key-minimum-32-chars-long

# ------------------------------------------------------------------------------
# 6. Redis & Background Worker Queue (BullMQ)
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
USE_IN_MEMORY_REDIS=false

# ------------------------------------------------------------------------------
# 7. Security, Privacy & Admin APIs
# ------------------------------------------------------------------------------
ADMIN_API_KEY=taptch_admin_secret_key_2026
VISITOR_SALT_SECRET=taptch-visitor-salt-2026-production-entropy
OTP_PROVIDER=console

# ------------------------------------------------------------------------------
