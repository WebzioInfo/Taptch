# ==========================================
# TAPPZIO ENVIRONMENT CONFIGURATION (.env.example)
# Copy to .env.local for local development
# ==========================================

# 1. APPLICATION & SERVER RUNTIME
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BRAND_NAME="Tappzio"

# 2. DATABASE (PostgreSQL & PgBouncer / Supabase Pooler IPv4)
# Direct / Session connection (used by Drizzle migrations & seed scripts)
DATABASE_URL_DIRECT="postgresql://postgres.hwrgtzkhcdklizyfargh:Tapzio%402026@aws-0-eu-west-1.pooler.supabase.com:5432/postgres?sslmode=require"
# Pooled connection (used by the running web application via PgBouncer / Supabase Transaction Pooler, IPv4-safe)
DATABASE_URL_POOLED="postgresql://postgres.hwrgtzkhcdklizyfargh:Tapzio%402026@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?sslmode=require"
# Default DATABASE_URL falls back to pooled in app, direct in migrations
# NOTE: Supabase direct endpoints (db.<ref>.supabase.co) are IPv6-only. In IPv4 Docker/VPS environments,
# always use the Supabase Pooler host (aws-0-<region>.pooler.supabase.com) on port 6543 or 5432.
DATABASE_URL="postgresql://postgres.hwrgtzkhcdklizyfargh:Tapzio%402026@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?sslmode=require"
# Use embedded PGlite WASM in local dev/testing if external Postgres is not running
USE_PGLITE_DEV=false

# 3. CACHE & MESSAGE QUEUE (Redis / Valkey)
REDIS_URL="redis://localhost:6379"

# 4. AUTHENTICATION (Better Auth)
BETTER_AUTH_SECRET="tapzio-development-better-auth-secret-minimum-32-chars"
BETTER_AUTH_URL="http://localhost:3000"

# Optional OAuth (Leave empty in local dev to disable social login buttons)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# 5. COMMUNICATIONS (Email & OTP)
# Options: 'smtp' (standard SMTP / Gmail / SES / Brevo / Mailgun), 'mailpit' (local dev), 'console' (stdout only)
EMAIL_PROVIDER="smtp"
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="noreply@tappzio.com"
EMAIL_FROM_NAME="Tappzio"

# OTP Delivery Provider: 'console' (local dev), 'whatsapp' (production Meta Cloud API), 'msg91' (DLT SMS)
OTP_PROVIDER="console"
META_WHATSAPP_TOKEN=""
META_WHATSAPP_PHONE_NUMBER_ID=""
MSG91_AUTH_KEY=""
MSG91_DLT_TE_ID=""

# 6. OBJECT STORAGE & CLOUDINARY MEDIA
# Primary media management, image/video optimization & CDN delivery
CLOUDINARY_CLOUD_NAME="dhydmxcq2"
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="dhydmxcq2"
NEXT_PUBLIC_CLOUDINARY_API_KEY=""

# Optional Object Storage (MinIO / Cloudflare R2 / S3)
STORAGE_PROVIDER="cloudinary"
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET_NAME="tapzio-media"
S3_PUBLIC_URL="http://localhost:9000/tapzio-media"

# 7. BOT DEFENSE & OBSERVABILITY
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"
NEXT_PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
LOG_LEVEL="debug"
SENTRY_DSN=""
ENABLE_SENTRY=false

# 8. SUPABASE (Hosted Database & Storage)
NEXT_PUBLIC_SUPABASE_URL="https://hwrgtzkhcdklizyfargh.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_NRQz3uzNEGBBSCdFOA7SDA_4E6P0RZ0"
# To use Supabase hosted Postgres for Tapzio, replace [YOUR-PASSWORD] with your actual Supabase DB password:
# SUPABASE_DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.hwrgtzkhcdklizyfargh.supabase.co:5432/postgres"


