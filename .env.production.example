# ==============================================================================
# TAPTCH — Production Environment Configuration (.env.production)
# Target Host: Coolify / Dokploy / VPS / Docker / Cloudflare CDN
# Domain: https://taptch.com
# ==============================================================================

NODE_ENV=production

# ------------------------------------------------------------------------------
# 1. Supabase PostgreSQL Production Database (Pooled & Direct via SSL)
# ------------------------------------------------------------------------------
# Authoritative Supabase pooled connection string (Port 5432 with mandatory SSL)
DATABASE_URL=postgresql://postgres:TaptchTAPH12@db.nvrcgauxafpxsaufjtha.supabase.co:5432/postgres?sslmode=require

# Direct connection string for Drizzle migration execution
DATABASE_URL_DIRECT=postgresql://postgres:TaptchTAPH12@db.nvrcgauxafpxsaufjtha.supabase.co:5432/postgres?sslmode=require

# ------------------------------------------------------------------------------
# 2. Supabase Client & SSR Keys
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://nvrcgauxafpxsaufjtha.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_bnnLxVjJ-o9guCQQeDDz2w_pwUQrk5b
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ------------------------------------------------------------------------------
# 3. Cloudflare Storage & Global CDN Delivery (Images & R2)
# ------------------------------------------------------------------------------
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_IMAGES_API_TOKEN=your_cloudflare_images_api_token_here
CLOUDFLARE_IMAGES_ACCOUNT_HASH=your_cloudflare_images_account_hash_here

CLOUDFLARE_R2_ACCESS_KEY_ID=your_cloudflare_r2_access_key_id_here
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_cloudflare_r2_secret_access_key_here
CLOUDFLARE_R2_BUCKET_NAME=taptch-media
CLOUDFLARE_R2_ENDPOINT=https://your_cloudflare_account_id_here.r2.cloudflarestorage.com
CLOUDFLARE_R2_PUBLIC_BASE_URL=https://assets.taptch.com

# ------------------------------------------------------------------------------
# 4. Outbound Transactional Email (SMTP / SendGrid / Resend)
# ------------------------------------------------------------------------------
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=apikey
SMTP_PASS=your_sendgrid_or_smtp_password_here
EMAIL_FROM=noreply@taptch.com
EMAIL_FROM_NAME="TAPTCH"

# ------------------------------------------------------------------------------
# 5. Application URLs & Authentication (Better Auth)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://taptch.com
BETTER_AUTH_URL=https://taptch.com
# Must be a 32+ character high-entropy cryptographically secure secret in production:
BETTER_AUTH_SECRET=taptch-super-secret-better-auth-key-production-entropy-64chars

# ------------------------------------------------------------------------------
# 6. Redis & Background Worker Queue (BullMQ)
# ------------------------------------------------------------------------------
# In production, point to your managed Redis or containerized Redis service:
REDIS_URL=redis://default:your_redis_password_here@redis:6379
USE_IN_MEMORY_REDIS=false

# ------------------------------------------------------------------------------
# 7. Security, Privacy & DPDP Compliance
# ------------------------------------------------------------------------------
ADMIN_API_KEY=taptch_admin_secret_key_prod_2026
# Daily rotating salt for hashing visitor IP addresses under India DPDP Act compliance:
VISITOR_SALT_SECRET=taptch-visitor-salt-production-entropy-rotating-salt-2026
OTP_PROVIDER=fast2sms
