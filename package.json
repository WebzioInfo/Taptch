{
  "name": "tappzio",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.13.0",
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_ENV=development next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:db": "vitest run tests/integration",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:studio": "drizzle-kit studio",
    "worker": "tsx src/worker/index.ts",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\"",
    "postinstall": "node scripts/patch-minimatch.mjs"
  },
  "dependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@electric-sql/pglite": "^0.5.13",
    "@fontsource/noto-sans-devanagari": "^5.2.5",
    "@fontsource/noto-sans-malayalam": "^5.2.5",
    "@fontsource/plus-jakarta-sans": "^5.2.5",
    "@hookform/resolvers": "^4.1.3",
    "@radix-ui/react-avatar": "^1.1.3",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-toast": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-query": "^5.67.2",
    "better-auth": "^1.7.14",
    "bullmq": "^6.5.3",
    "class-variance-authority": "^0.7.1",
    "cloudinary": "^2.11.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "framer-motion": "^12.4.10",
    "ioredis": "^6.0.0",
    "lucide-react": "^0.475.0",
    "next": "^15.5.0",
    "next-intl": "^4.14.9",
    "nodemailer": "^10.3.1",
    "pdf-lib": "^1.17.1",
    "pino": "^10.4.0",
    "postgres": "^3.4.5",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.2",
    "tailwind-merge": "^3.0.2",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.6.7",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@types/node": "^22.13.9",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@typescript-eslint/eslint-plugin": "^8.26.0",
    "@typescript-eslint/parser": "^8.26.0",
    "autoprefixer": "^10.4.20",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.7",
    "drizzle-kit": "^0.31.8",
    "eslint": "^9.21.0",
    "eslint-config-next": "^15.5.0",
    "eslint-config-prettier": "^10.0.2",
    "pino-pretty": "^13.0.0",
    "postcss": "^8.5.32",
    "prettier": "^3.5.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "postcss": "$postcss",
    "esbuild": "^0.25.12",
    "minimatch": "^11.0.4",
    "@swc/helpers": "^0.5.17"
  }
}